# Supabase (use service_role key ONLY in GitHub Actions / server-side pipeline)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# LLM Provider API Key (Gemini Free Tier by default; swap via LiteLLM env vars)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# MISTRAL_API_KEY=""
# GROQ_API_KEY=""

# Provider-agnostic LiteLLM model identifiers
TRIAGE_MODEL="gemini/gemini-3.5-flash-lite"
SYNTHESIS_MODEL="gemini/gemini-3.8-flash"

# Free-tier rate-limit resilience
LLM_THROTTLE_SECONDS="4.5"
LLM_MAX_RETRIES="5"
LLM_TIMEOUT_SECONDS="60"

# Phase 2: Owner-Only Daily Email Alerts via Resend (optional)
RESEND_API_KEY=""
ALERT_RECIPIENT_EMAIL=""
ALERT_FROM_EMAIL="CrossRead Alerts <onboarding@resend.dev>"
DASHBOARD_URL="https://your-app.vercel.app"
ALERTS_ENABLED="true"
