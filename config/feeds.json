{
  "schema_version": "1.0",
  "settings": {
    "rolling_cluster_window_hours": 72,
    "min_word_count": 150,
    "max_response_bytes": 5242880,
    "request_timeout_seconds": 15,
    "bot_wall_markers": [
      "verify you are human",
      "enable javascript",
      "access denied",
      "cloudflare",
      "just a moment...",
      "attention required!",
      "please turn javascript on"
    ]
  },
